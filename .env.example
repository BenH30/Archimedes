# Copy this file to .env and fill in your values for local development.
# Production values go in Railway environment variables.

# Switch to SMTP for real email sending (leave blank to use console output in dev)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP — use an App Password (myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# The "From" address on outgoing emails
DEFAULT_FROM_EMAIL=info@archimedesmetals.com
